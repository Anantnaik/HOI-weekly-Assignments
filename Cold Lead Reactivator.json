    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"You are a real estate market analyst. Research the current market situation for the given area and find what has meaningfully changed since the buyer went cold.\\n\\nAREA: {{ $json.original_area }}\\nBUDGET: {{ $json.original_budget }}\\nORIGINAL CRITERIA: {{ $json.original_criteria }}\\nLAST CONTACT: {{ $json.last_contact_date }}\\n\\nUse Google Search to find recent listings, price movements, new launches, and market changes for this specific area. Do 2-3 focused searches maximum, then compile findings.\\n\\nAfter searching, return ONLY a valid JSON object with these exact keys. Do not include any markdown fences, no explanations, no prose. Just the raw JSON object starting with { and ending with }.\\n\\nRequired JSON keys:\\n- price_movement: short string describing any price changes (max 20 words)\\n- new_launches: array of 2-3 project name strings launched in this area\\n- notable_changes: short string covering infra rate cuts policy shifts (max 30 words)\\n- opportunity_hook: ONE sentence describing why this buyer should re-engage now (max 25 words)\\n- confidence: high or medium or low\\n\\nBE CONCISE. Keep each field short. Return raw JSON only. No markdown fences.\"\n    }]\n  }],\n  \"tools\": [{\"google_search\": {}}],\n  \"generationConfig\": {\n    \"temperature\": 0.4,\n    \"maxOutputTokens\": 8192,\n    \"thinkingConfig\": {\n      \"thinkingBudget\": 1024\n    }\n  }\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 60000
        }
      },
