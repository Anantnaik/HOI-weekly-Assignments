    {
      "parameters": {
        "jsCode": "const textOf = (resp) => {\n  const c = resp && resp.candidates && resp.candidates[0];\n  const parts = (c && c.content && c.content.parts) || [];\n  return parts.filter(p => typeof p.text === \"string\" && !p.thought).map(p => p.text).join(\"\");\n};\nconst parseJson = (raw) => {\n  let t = String(raw || \"\").trim();\n  t = t.replace(/^```json/i, \"\").replace(/^```/, \"\").replace(/```$/, \"\").trim();\n  const s = t.indexOf(\"{\");\n  const e = t.lastIndexOf(\"}\");\n  if (s !== -1 && e !== -1) t = t.slice(s, e + 1);\n  try { return JSON.parse(t); } catch (err) { return null; }\n};\nconst responses = $input.all();\nconst polished = $(\"Parse Polish\").all();\nconst out = [];\nfor (let i = 0; i < responses.length; i++) {\n  const p = polished[i] ? polished[i].json : {};\n  const raw = responses[i] ? responses[i].json : {};\n  const txt = textOf(raw);\n  const g = parseJson(txt);\n  let verdict = \"revise\";\n  let summary = \"Guard did not return readable JSON, so this piece was held back as a precaution.\";\n  let violations = [];\n  let banned = [];\n  let score = 0;\n  let risk = \"none\";\n  if (g) {\n    violations = Array.isArray(g.violations) ? g.violations : [];\n    banned = Array.isArray(g.banned_words_found) ? g.banned_words_found : [];\n    score = typeof g.score === \"number\" ? g.score : 0;\n    risk = g.risk_notes || \"none\";\n    summary = g.one_line_summary || \"Guard returned no summary line.\";\n    const v = String(g.verdict || \"revise\").toLowerCase().trim();\n    verdict = (v === \"pass\" && violations.length === 0 && banned.length === 0) ? \"pass\" : \"revise\";\n  } else {\n    const errBlob = raw && raw.error ? JSON.stringify(raw.error) : JSON.stringify(raw);\n    summary = \"Brand guard could not be read. Raw response: \" + String(txt || errBlob).slice(0, 400);\n    violations = [\"brand guard did not respond with valid JSON\"];\n  }\n  out.push({ json: Object.assign({}, p, {\n    verdict: verdict,\n    score: score,\n    violations_text: violations.length ? violations.join(\" | \") : \"none\",\n    banned_text: banned.length ? banned.join(\", \") : \"none\",\n    risk_notes: risk,\n    guard_summary: summary,\n    checked_at: $now.toFormat(\"yyyy-MM-dd HH:mm\")\n  }) });\n}\nreturn out;"
      },
