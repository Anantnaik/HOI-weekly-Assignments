      "parameters": {
        "jsCode": "const out = [];\nconst rows = $input.all();\nfor (let i = 0; i < rows.length; i++) {\n  const r = rows[i].json;\n  if (!r || !r.content_id) continue;\n  const st = String(r.status || \"\").toLowerCase().trim();\n  if (st !== \"approved\" && st !== \"scheduled\") continue;\n  const sched = String(r.scheduled_for || \"\").trim();\n  let due = true;\n  if (sched) {\n    let dt = DateTime.fromFormat(sched, \"yyyy-MM-dd HH:mm\");\n    if (!dt.isValid) dt = DateTime.fromISO(sched);\n    if (dt.isValid) due = dt.toMillis() <= $now.toMillis();\n  }\n  if (due) out.push({ json: r });\n}\nreturn out.slice(0, 5);"
      },
      "id": "8fa05d27-156b-4ac8-b108-ce314357cc3d",
