    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"contents\":[{\"parts\":[{\"text\": {{ JSON.stringify(\"You are a brand compliance checker. You are the last gate before something is published under the brand name. Be strict but fair.\\n\\nBRAND VOICE\\nCreator: \" + ($(\"Load Brand Voice\").first().json.creator_name || \"\") + \"\\nTone: \" + ($(\"Load Brand Voice\").first().json.tone_notes || \"\") + \"\\nBANNED WORDS: \" + ($(\"Load Brand Voice\").first().json.banned_words || \"\") + \"\\n\\nTHE PIECE ABOUT TO BE PUBLISHED\\nPlatform: \" + ($json.platform || \"\") + \"\\nHook: \" + ($json.final_hook || \"\") + \"\\nBody: \" + ($json.final_body || \"\") + \"\\nHashtags: \" + ($json.final_hashtags || \"\") + \"\\nBody character count: \" + ($json.char_count || 0) + \"\\n\\nCHECK ALL OF THESE\\n1 Banned words must not appear anywhere.\\n2 There must be zero em-dash characters.\\n3 Length. x singles under 270 characters. linkedin hooks under 200 characters. quote_card quotes under 20 words.\\n4 Voice match against the creator described above, not generic corporate tone.\\n5 Flag any number, statistic or claim that sounds invented.\\n6 Flag anything misleading, discriminatory, or promising a financial outcome.\\n\\nReturn ONLY compact JSON with these keys: verdict, score, violations, banned_words_found, risk_notes, one_line_summary.\\nverdict is pass or revise. score is a number 0 to 100. violations is an array of short strings, empty if clean. banned_words_found is an array, empty if none. risk_notes is one short line or the word none. one_line_summary is ONE sentence under 20 words.\\nverdict is revise if there is any banned word, any em-dash, any length breach, or any real risk.\\nBe brief. Keep every string short.\") }} }]}],\"generationConfig\":{\"temperature\":0.1,\"maxOutputTokens\":4096,\"responseMimeType\":\"application/json\",\"thinkingConfig\":{\"thinkingBudget\":512}}}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 12000
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 90000
        }
      },
      "id": "4f79ba5f-7215-4561-bf95-4d7c73ac5127",
      "name": "Agent 8 - Brand Guard",
