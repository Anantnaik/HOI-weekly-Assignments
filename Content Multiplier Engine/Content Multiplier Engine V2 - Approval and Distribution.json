    {
      "parameters": {
        "jsCode": "const textOf = (resp) => {\n  const c = resp && resp.candidates && resp.candidates[0];\n  const parts = (c && c.content && c.content.parts) || [];\n  return parts.filter(p => typeof p.text === \"string\" && !p.thought).map(p => p.text).join(\"\");\n};\nconst parseJson = (raw) => {\n  let t = String(raw || \"\").trim();\n  t = t.replace(/^```json/i, \"\").replace(/^```/, \"\").replace(/```$/, \"\").trim();\n  const s = t.indexOf(\"{\");\n  const e = t.lastIndexOf(\"}\");\n  if (s !== -1 && e !== -1) t = t.slice(s, e + 1);\n  try { return JSON.parse(t); } catch (err) { return null; }\n};\nconst responses = $input.all();\nconst rows = $(\"Filter Due Now\").all();\nconst out = [];\nfor (let i = 0; i < responses.length; i++) {\n  const r = rows[i] ? rows[i].json : {};\n  const p = parseJson(textOf(responses[i].json)) || {};\n  out.push({ json: {\n    content_id: r.content_id,\n    source_id: r.source_id,\n    source_title: r.source_title,\n    platform: r.platform,\n    format: r.format,\n    timestamp_ref: r.timestamp_ref,\n    original_hook: r.hook,\n    original_body: r.body,\n    final_hook: p.final_hook || r.hook || \"\",\n    final_body: p.final_body || r.body || \"\",\n    final_hashtags: p.final_hashtags || r.hashtags || \"\",\n    final_cta: p.final_cta || r.cta || \"\",\n    char_count: p.char_count || String(p.final_body || r.body || \"\").length,\n    changes_made: p.changes_made || \"no changes\",\n    polish_ok: p.final_body ? true : false\n  } });\n}\nreturn out;"
      },
      "id": "6fdd0c29-add7-4645-9c6b-d0ad060bd6a6",
