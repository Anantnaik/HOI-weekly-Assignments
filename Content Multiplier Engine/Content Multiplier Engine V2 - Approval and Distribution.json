    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"contents\":[{\"parts\":[{\"text\": {{ JSON.stringify(\"You are a publishing editor. This piece was written and approved earlier. It is going live right now. Your job is a final tightening pass so it lands on the platform it is going to.\" + \"\\n\\nBRAND VOICE\\nCreator: \" + ($(\"Load Brand Voice\").first().json.creator_name || \"\") + \"\\nAudience: \" + ($(\"Load Brand Voice\").first().json.audience || \"\") + \"\\nTone: \" + ($(\"Load Brand Voice\").first().json.tone_notes || \"\") + \"\\nSignature phrases: \" + ($(\"Load Brand Voice\").first().json.signature_phrases || \"\") + \"\\nBANNED WORDS: \" + ($(\"Load Brand Voice\").first().json.banned_words || \"\") + \"\\n\\nTHE PIECE\\nPlatform: \" + ($json.platform || \"\") + \"\\nFormat: \" + ($json.format || \"\") + \"\\nSource: \" + ($json.source_title || \"\") + \"\\nTimestamp reference: \" + ($json.timestamp_ref || \"\") + \"\\nCurrent hook: \" + ($json.hook || \"\") + \"\\nCurrent body: \" + ($json.body || \"\") + \"\\nCurrent hashtags: \" + ($json.hashtags || \"\") + \"\\nCurrent cta: \" + ($json.cta || \"\") + \"\\n\\nPLATFORM RULES\\nlinkedin: hook must be under 200 characters, body 120 to 220 words, blank line between thoughts, 3 to 5 hashtags\\nx: single posts under 270 characters, threads numbered 1/ 2/ 3/, 0 to 2 hashtags\\nreels: spoken script 30 to 60 seconds, hook in the first 3 seconds, keep the on screen text line\\nnewsletter: keep valid HTML, subject under 60 characters\\nquote_card: quote under 20 words, keep the caption and the design direction lines\\n\\nTASK\\nReturn ONLY valid JSON, no markdown fences. The object has these keys: final_hook, final_body, final_hashtags, final_cta, char_count, changes_made.\\n\\nfinal_hook is the tightened hook\\nfinal_body is the tightened body, ready to paste with no edits\\nfinal_hashtags is the hashtag line or an empty string\\nfinal_cta is the closing line or an empty string\\nchar_count is the number of characters in final_body as a number\\nchanges_made is one short line describing what you changed\\n\\nRULES\\nKeep the meaning and the specifics. Do not invent new facts.\\nRemove any em-dash and replace it with a full stop or a comma.\\nRemove every banned word listed above.\\nIf the piece is already tight, say so in changes_made and return it close to unchanged.\") }} }]}],\"generationConfig\":{\"temperature\":0.4,\"maxOutputTokens\":4096,\"responseMimeType\":\"application/json\"}}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 12000
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 90000
        }
      },
